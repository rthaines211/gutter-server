<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ryan.comic-bubbles</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Library/Application Support/comic-bubbles/venv/bin/python</string>
    <string>__REPO__/hostjob/bubbles/bubblejob.py</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/comic-bubbles.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/comic-bubbles.log</string>
</dict>
</plist>
