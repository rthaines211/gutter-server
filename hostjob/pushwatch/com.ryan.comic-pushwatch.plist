<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ryan.comic-pushwatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/bin/comic-pushwatch</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/comic-pushwatch.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/comic-pushwatch.log</string>
</dict>
</plist>
